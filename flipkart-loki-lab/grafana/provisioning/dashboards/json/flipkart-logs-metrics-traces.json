{
  "title": "Flipkart - Metrics, Logs and Traces",
  "uid": "flipkart-mlt",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "title": "P95 / P99 latency (find the slow window here first)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, endpoint))", "legendFormat": "P95 {{endpoint}}", "refId": "A" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[1m])) by (le, endpoint))", "legendFormat": "P99 {{endpoint}}", "refId": "B" }
      ]
    },
    {
      "id": 2, "title": "Application logs (all services, structured JSON)", "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"flipkart\"}", "refId": "A" }]
    },
    {
      "id": 3, "title": "Slow payment events (LogQL filter)", "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"flipkart\", service=\"flipkart-payment-consumer\"} |= \"slow\"", "refId": "A" }]
    },
    {
      "id": 4, "title": "Failed payment events (LogQL filter)", "type": "logs",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true },
      "targets": [{ "expr": "{job=\"flipkart\", level=\"ERROR\"}", "refId": "A" }]
    }
  ]
}
